-- Créer la table des catégories de produit
CREATE TABLE categories_produit (
 id_categorie INT NOT NULL,
 nom_categorie INT NOT NULL
)

-- Extraire les catégories uniques
CREATE OR REPLACE TABLE categories_produit AS
SELECT
 ROW_NUMBER() OVER() AS id_categorie, -- Générer un identifiant unique pour
chaque catégorie
 categorie_produit AS nom_categorie
FROM Produits
GROUP BY categorie_produit

-- Ajouter la colonne id_categorie dans la table produits
ALTER TABLE Produits ADD COLUMN id_categorie INT;

-- Mettre à jour la table produits pour utiliser la clé étrangère
UPDATE Produits p
SET id_categorie = (
 SELECT id_categorie FROM categories_produit cp
 WHERE p.categorie_produit = cp.nom_categorie
)
WHERE p.id_produit IS NOT NULL;

-- Supprimer l'ancienne colonne categorie_produit
ALTER TABLE Produits DROP COLUMN categorie_produit